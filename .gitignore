# Deny by default. Only the public tool and transported session formats are allowed.
*
!.gitignore
!.gitattributes
!LICENSE
!README.md
!docs/
!docs/**
!*.cmd
!*.ps1
!*.psd1
!Agents/
!Agents/*.psd1
!ACTIVE_HOST.txt
!Claude/
!Claude/**/
!Claude/**/*.jsonl
!Claude/**/*.entry.json
!Codex/
!Codex/**/
!Codex/**/*.jsonl
!Codex/**/*.jsonl.gz
!Codex/**/*.jsonl.gz.integrity.json
!Launchers/
!Launchers/**
Launchers/Shortcuts/*.lnk
!examples/
!examples/**

# Machine-local configuration must never be committed.
AgentSessionSync.config.psd1

# Explicit credential and local database blocks.
auth.json
config.toml
*.db
*.sqlite
*.sqlite3
*.key
*.pem
*.pfx
*.env
